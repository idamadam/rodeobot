# Discord bot credentials and destination channel
DISCORD_BOT_TOKEN=replace_with_bot_token
GENERAL_CHANNEL_ID=123456789012345678

# Discord user IDs are numeric snowflakes, not usernames or @handles.
FRIENDS_JSON=[{"discordUserId":"123456789012345678","birthday":"January 15"}]

# Daily at 08:00 in Australia/Melbourne.
BIRTHDAY_CRON_SCHEDULE=0 8 * * *

# Required only by `npm run deploy-commands`.
CLIENT_ID=123456789012345678
GUILD_ID=123456789012345678
