{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rodeobot",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 21 * * *", "0 22 * * *"]
  },
  "secrets": {
    "required": ["DISCORD_WEBHOOK_URL", "FRIENDS_JSON", "LETTERLOOP_WEBHOOK_URL"]
  }
}
