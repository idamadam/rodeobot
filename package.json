{
  "name": "rodeobot",
  "version": "1.0.0",
  "private": true,
  "description": "A Discord bot for birthday announcements, reminders, and lightweight slash commands.",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85",
    "deploy-commands": "node --env-file-if-exists=.env src/deploy-commands.js"
  },
  "license": "ISC",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "discord.js": "^14.27.0",
    "node-cron": "^4.6.0",
    "spacetime": "^7.13.0"
  }
}
