{
  "name": "rodeobot",
  "version": "1.0.0",
  "private": true,
  "description": "A scheduled Cloudflare Worker for Discord birthday announcements and reminders.",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85",
    "validate:config": "node --env-file-if-exists=.dev.vars scripts/validate-config.js",
    "friends:validate": "node scripts/friends.js validate",
    "friends:upload": "node scripts/friends.js upload",
    "deploy": "wrangler deploy",
    "deploy:configured": "node --env-file=.dev.vars scripts/deploy-configured.js",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "license": "ISC",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
